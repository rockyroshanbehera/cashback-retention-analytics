# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Generated database (~40 MB). Rebuilt by src/run_pipeline.py.
database/*.db

# Full generated CSVs (~30 MB). Only the deterministic 250-row samples are committed,
# so the schema stays reviewable without running the pipeline.
data/processed/*.csv
!data/processed/*_sample.csv

# Per-customer experiment detail (~2.7 MB) and the full RFM export (~2.2 MB) are
# regenerated by the pipeline; the committed sample and aggregated profile cover review.
outputs/rfm_segments.csv

# Intermediate sheet renders. outputs/dashboard_preview.png is committed.
outputs/charts/
